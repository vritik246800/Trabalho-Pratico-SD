<%@ page pageEncoding="UTF-8" %>
<%-- A11 — paisagem das páginas públicas: sol a nascer sobre a machamba, sulcos a desenhar-se, brotos a crescer --%>
<svg class="campo" viewBox="0 0 600 720" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
        <linearGradient id="g-ceu" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#262F1A"/><stop offset="1" stop-color="#4A4A25"/></linearGradient>
        <linearGradient id="g-terra" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6B4A26"/><stop offset="1" stop-color="#3B2A17"/></linearGradient>
    </defs>
    <rect width="600" height="720" fill="url(#g-ceu)"/>
    <g class="sol-grupo"><g transform="translate(430 395)"><g class="raios"><path d="M0-84V-104" transform="rotate(0)"/><path d="M0-84V-104" transform="rotate(30)"/><path d="M0-84V-104" transform="rotate(60)"/><path d="M0-84V-104" transform="rotate(90)"/><path d="M0-84V-104" transform="rotate(120)"/><path d="M0-84V-104" transform="rotate(150)"/><path d="M0-84V-104" transform="rotate(180)"/><path d="M0-84V-104" transform="rotate(210)"/><path d="M0-84V-104" transform="rotate(240)"/><path d="M0-84V-104" transform="rotate(270)"/><path d="M0-84V-104" transform="rotate(300)"/><path d="M0-84V-104" transform="rotate(330)"/></g><circle class="sol-disco" r="62"/></g></g>
