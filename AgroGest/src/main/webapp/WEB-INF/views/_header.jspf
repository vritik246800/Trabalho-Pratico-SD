<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="pt_PT"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="eu" value="${sessionScope.utilizador}"/>
<%-- página actual (URL original, não a JSP do forward) → link do menu em destaque --%>
<c:set var="aqui" value="${fn:substringAfter(empty requestScope['jakarta.servlet.forward.request_uri'] ? pageContext.request.requestURI : requestScope['jakarta.servlet.forward.request_uri'], ctx)}"/>
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AgroGest<c:if test="${not empty titulo}"> · <c:out value="${titulo}"/></c:if></title>
    <link rel="stylesheet" href="${ctx}/css/style.css">
    <c:forEach var="css" items="${estilos}"><link rel="stylesheet" href="${ctx}/css/${css}"></c:forEach>
</head>
<body>
<header class="topo">
    <div class="container topo-barra">
        <a class="marca" href="${ctx}/">🌱 AgroGest</a>
        <input type="checkbox" id="menu-toggle" class="menu-toggle">
        <label for="menu-toggle" class="menu-botao" aria-label="Abrir menu">☰</label>
        <nav class="menu">
            <c:choose>
                <c:when test="${eu.admin}">
                    <a href="${ctx}/admin"${aqui == '/admin' ? ' class="activo" aria-current="page"' : ''}>Dashboard</a>
                    <a href="${ctx}/admin/fornecedores"${aqui == '/admin/fornecedores' ? ' class="activo" aria-current="page"' : ''}>Fornecedores</a>
                    <a href="${ctx}/admin/produtos"${aqui == '/admin/produtos' ? ' class="activo" aria-current="page"' : ''}>Produtos</a>
                    <a href="${ctx}/admin/campanhas"${aqui == '/admin/campanhas' ? ' class="activo" aria-current="page"' : ''}>Campanhas</a>
                    <a href="${ctx}/admin/cultivos"${aqui == '/admin/cultivos' ? ' class="activo" aria-current="page"' : ''}>Cultivos</a>
                    <a href="${ctx}/admin/colheitas"${aqui == '/admin/colheitas' ? ' class="activo" aria-current="page"' : ''}>Colheitas</a>
                    <a href="${ctx}/admin/listagens"${aqui == '/admin/listagens' ? ' class="activo" aria-current="page"' : ''}>Listagens</a>
                    <a href="${ctx}/admin/relatorios"${aqui == '/admin/relatorios' ? ' class="activo" aria-current="page"' : ''}>Relatórios</a>
                    <a href="${ctx}/admin/persistencia"${aqui == '/admin/persistencia' ? ' class="activo" aria-current="page"' : ''}>Persistência</a>
                    <a href="${ctx}/factura"${aqui == '/factura' ? ' class="activo" aria-current="page"' : ''}>Facturas</a>
                </c:when>
                <c:when test="${not empty eu}">
                    <a href="${ctx}/catalogo"${aqui == '/catalogo' ? ' class="activo" aria-current="page"' : ''}>Catálogo</a>
                    <a href="${ctx}/carrinho"${aqui == '/carrinho' ? ' class="activo" aria-current="page"' : ''}>Carrinho<c:if test="${not empty sessionScope.carrinho}"> <span class="contador">${fn:length(sessionScope.carrinho)}</span></c:if></a>
                    <a href="${ctx}/minhas-compras"${aqui == '/minhas-compras' ? ' class="activo" aria-current="page"' : ''}>Minhas compras</a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/login"${aqui == '/login' ? ' class="activo" aria-current="page"' : ''}>Entrar</a>
                    <a href="${ctx}/registo"${aqui == '/registo' ? ' class="activo" aria-current="page"' : ''}>Registar</a>
                </c:otherwise>
            </c:choose>
            <c:if test="${not empty eu}">
                <span class="menu-user" title="${eu.admin ? 'Administrador' : 'Cliente'}">👤 <c:out value="${eu.nome}"/></span>
                <a href="${ctx}/logout">Sair</a>
            </c:if>
        </nav>
    </div>
</header>
<main class="container">
<c:if test="${not empty sessionScope.flash}">
    <div class="alerta alerta-ok"><c:out value="${sessionScope.flash}"/></div>
    <c:remove var="flash" scope="session"/>
</c:if>
<c:if test="${not empty erro}">
    <div class="alerta alerta-erro"><c:out value="${erro}"/></div>
</c:if>
