<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="pt_PT"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="eu" value="${sessionScope.utilizador}"/>
<%-- página actual (URL original, não a JSP do forward) → link do menu em destaque --%>
<c:set var="aqui" value="${fn:substringAfter(empty requestScope['jakarta.servlet.forward.request_uri'] ? pageContext.request.requestURI : requestScope['jakarta.servlet.forward.request_uri'], ctx)}"/>
<c:set var="activo" value=' class="nav-link activo" aria-current="page"'/>
<c:set var="normal" value=' class="nav-link"'/>
<%-- ?v= muda a cada redesenho: o browser não usa CSS/JS antigo da cache --%>
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#262F1A">
    <title>AgroGest<c:if test="${not empty titulo}"> · <c:out value="${titulo}"/></c:if></title>
    <link rel="icon" href="${ctx}/img/logo.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="${ctx}/css/style.css?v=12">
    <c:forEach var="css" items="${estilos}"><link rel="stylesheet" href="${ctx}/css/${css}?v=12"></c:forEach>
    <%-- antes do primeiro desenho: sem "salto" do menu recolhido nem do wizard --%>
    <link rel="stylesheet" href="${ctx}/css/motion.css?v=12">
    <%-- antes do primeiro desenho: sem "salto" do menu recolhido nem do wizard; A14: esconder o que o GSAP vai animar
         (e a cortina, se se veio de outro painel) — tira-se sozinho ao fim de 3 s se o motion.js não correr --%>
    <script>(function(h){h.classList.add('js');try{if(localStorage.getItem('agro-menu')==='recolhido')h.classList.add('menu-recolhido');if(!matchMedia('(prefers-reduced-motion: reduce)').matches){var n=sessionStorage.getItem('agro-nav');h.classList.add('a-entrar');if(n)h.classList.add('nav-'+n);setTimeout(function(){h.classList.remove('a-entrar','nav-painel','nav-entrada','nav-leve')},3000)}}catch(e){}})(document.documentElement)</script>
    <script src="${ctx}/js/app.js?v=12" defer></script>
    <script src="${ctx}/js/vendor/gsap.min.js?v=3.15.0" defer></script>
    <script src="${ctx}/js/motion.js?v=12" defer></script>
    <script type="module" src="${ctx}/js/cena3d.js?v=12"></script>
</head>
<body class="${empty eu ? 'publico' : 'app'}" data-pagina="${fn:escapeXml(aqui)}">
<%@ include file="_icones.jspf" %>
<div class="cortina" aria-hidden="true"><svg class="ic cortina-logo"><use href="#i-logo"/></svg><c:if test="${not empty eu}"><p class="cortina-ola">Olá, <c:out value="${fn:split(eu.nome, ' ')[0]}"/></p></c:if></div>
<c:choose>
<c:when test="${empty eu}">
<main class="publico-main">
</c:when>
<c:otherwise>
<div class="shell">
    <aside class="lateral" id="lateral" aria-label="Menu principal">
        <a class="marca" href="${ctx}/">
            <svg class="marca-logo" aria-hidden="true"><use href="#i-logo"/></svg>
            <span class="marca-nome">Agro<em>Gest</em></span>
        </a>
        <nav class="nav">
            <c:choose>
                <c:when test="${eu.admin}">
                    <a href="${ctx}/admin"${aqui == '/admin' ? activo : normal}><svg class="ic"><use href="#i-painel"/></svg><span>Painel</span></a>
                    <p class="nav-grupo">Catálogo</p>
                    <a href="${ctx}/admin/fornecedores"${aqui == '/admin/fornecedores' ? activo : normal}><svg class="ic"><use href="#i-fornecedor"/></svg><span>Fornecedores</span></a>
                    <a href="${ctx}/admin/produtos"${aqui == '/admin/produtos' ? activo : normal}><svg class="ic"><use href="#i-produto"/></svg><span>Produtos</span></a>
                    <p class="nav-grupo">Produção</p>
                    <a href="${ctx}/admin/campanhas"${aqui == '/admin/campanhas' ? activo : normal}><svg class="ic"><use href="#i-campanha"/></svg><span>Campanhas</span></a>
                    <a href="${ctx}/admin/cultivos"${aqui == '/admin/cultivos' ? activo : normal}><svg class="ic"><use href="#i-cultivo"/></svg><span>Cultivos</span></a>
                    <a href="${ctx}/admin/colheitas"${aqui == '/admin/colheitas' ? activo : normal}><svg class="ic"><use href="#i-colheita"/></svg><span>Colheitas</span></a>
                    <p class="nav-grupo">Vendas</p>
                    <a href="${ctx}/factura"${aqui == '/factura' ? activo : normal}><svg class="ic"><use href="#i-factura"/></svg><span>Facturas</span></a>
                    <a href="${ctx}/admin/listagens"${aqui == '/admin/listagens' ? activo : normal}><svg class="ic"><use href="#i-listagem"/></svg><span>Listagens</span></a>
                    <a href="${ctx}/admin/relatorios"${aqui == '/admin/relatorios' ? activo : normal}><svg class="ic"><use href="#i-relatorio"/></svg><span>Relatórios</span></a>
                    <p class="nav-grupo">Sistema</p>
                    <a href="${ctx}/admin/persistencia"${aqui == '/admin/persistencia' ? activo : normal}><svg class="ic"><use href="#i-persistencia"/></svg><span>Persistência</span></a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/catalogo"${aqui == '/catalogo' ? activo : normal}><svg class="ic"><use href="#i-catalogo"/></svg><span>Catálogo</span></a>
                    <a href="${ctx}/carrinho"${fn:startsWith(aqui, '/carrinho') || aqui == '/compra' ? activo : normal}><svg class="ic"><use href="#i-carrinho"/></svg><span>Carrinho</span><c:if test="${not empty sessionScope.carrinho}"><b class="contador">${fn:length(sessionScope.carrinho)}</b></c:if></a>
                    <a href="${ctx}/minhas-compras"${aqui == '/minhas-compras' || aqui == '/factura' ? activo : normal}><svg class="ic"><use href="#i-compras"/></svg><span>Minhas compras</span></a>
                </c:otherwise>
            </c:choose>
        </nav>
        <div class="lateral-fim">
            <div class="quem" title="${fn:escapeXml(eu.email)}">
                <span class="avatar" aria-hidden="true">${fn:escapeXml(fn:toUpperCase(fn:substring(eu.nome, 0, 1)))}</span>
                <span class="quem-texto"><strong><c:out value="${eu.nome}"/></strong><small>${eu.admin ? 'Administrador' : 'Cliente'}</small></span>
            </div>
            <a class="nav-link" href="${ctx}/logout"><svg class="ic"><use href="#i-sair"/></svg><span>Sair</span></a>
        </div>
    </aside>
    <div class="fundo-gaveta" data-menu></div>
    <div class="area">
        <header class="barra">
            <button class="btn-icone botao-menu" type="button" data-menu aria-controls="lateral" aria-label="Mostrar ou esconder o menu">
                <svg class="ic"><use href="#i-menu"/></svg>
            </button>
            <p class="barra-trilho"><span>${eu.admin ? 'Administração' : 'Loja'}</span><c:if test="${not empty titulo}"><svg class="ic"><use href="#i-seta-dir"/></svg><c:out value="${titulo}"/></c:if></p>
            <c:if test="${not eu.admin}">
                <a class="btn btn-sec btn-peq barra-carrinho" href="${ctx}/carrinho"><svg class="ic"><use href="#i-carrinho"/></svg><span>Carrinho</span><c:if test="${not empty sessionScope.carrinho}"><b class="contador">${fn:length(sessionScope.carrinho)}</b></c:if></a>
            </c:if>
        </header>
<main class="conteudo">
</c:otherwise>
</c:choose>
<%-- páginas públicas (login, registo) mostram os alertas dentro do formulário --%>
<c:if test="${not empty eu}"><%@ include file="_alertas.jspf" %></c:if>
